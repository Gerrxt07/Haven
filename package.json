{
	"name": "haven",
	"version": "2026.4.29",
	"description": "Your new Voice, Video and Chat application to connect with your friends!",
	"author": "Cloudly <haven@becloudly.eu>",
	"license": "LicenseRef-Haven-SAL-1.0",
	"main": "dist-electron/main.js",
	"private": true,
	"devDependencies": {
		"@biomejs/biome": "2.5.1",
		"@commitlint/cli": "21.1.0",
		"@commitlint/config-conventional": "21.1.0",
		"@electron/fuses": "2.1.2",
		"@eslint/js": "10.0.1",
		"@tailwindcss/postcss": "4.3.1",
		"@types/bun": "1.3.14",
		"@types/javascript-obfuscator": "0.17.0",
		"@types/node": "26.0.1",
		"autoprefixer": "10.5.2",
		"electron": "42.5.0",
		"electron-builder": "26.15.3",
		"esbuild": "0.28.1",
		"eslint": "10.6.0",
		"husky": "9.1.7",
		"javascript-obfuscator": "5.4.3",
		"knip": "6.22.0",
		"lint-staged": "17.0.8",
		"postcss": "8.5.15",
		"rollup-plugin-obfuscator": "1.1.0",
		"shadcn-solid": "0.7.7",
		"tailwindcss": "4.3.1",
		"typescript": "6.0.3",
		"typescript-eslint": "8.62.0",
		"vite": "8.1.0",
		"vite-plugin-electron": "1.1.0",
		"vite-plugin-electron-renderer": "1.0.0",
		"vite-plugin-solid": "2.11.12"
	},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"test": "bun test",
		"format": "biome check --write --unsafe .",
		"lint": "biome check .",
		"lint-staged": "lint-staged",
		"knip": "knip",
		"prepare": "husky",
		"check": "bun run format && bun run test && bun run typecheck && bun run prepare",
		"dev": "vite",
		"dev:checked": "bun run check && vite",
		"build": "bun run check && vite build && bun run build:bytenode",
		"build:bytenode": "bun ./scripts/compile-bytenode.mjs",
		"package:win": "bun run build && bun run build:integrity && electron-builder --win --publish never",
		"package:mac": "bun run build && bun run build:integrity && electron-builder --mac --publish never",
		"package:linux": "bun run build && bun run build:integrity && electron-builder --linux --publish never",
		"build:integrity": "bun ./scripts/build-integrity-manifest.mjs",
		"protect": "bun run build:integrity"
	},
	"build": {
		"appId": "com.haven.app",
		"productName": "Haven",
		"generateUpdatesFilesForAllChannels": true,
		"publish": [
			{
				"provider": "github",
				"owner": "gerrxt07",
				"repo": "haven"
			}
		],
		"icon": "public/logo.png",
		"directories": {
			"output": "release",
			"buildResources": "build"
		},
		"files": [
			"dist/**",
			"dist-electron/**",
			"package.json"
		],
		"mac": {
			"icon": "public/logo.png",
			"target": [
				"dmg",
				"zip"
			]
		},
		"win": {
			"icon": "public/icon.ico",
			"target": [
				"nsis",
				"zip"
			],
			"publish": [
				{
					"provider": "github",
					"owner": "gerrxt07",
					"repo": "haven"
				}
			]
		},
		"nsis": {
			"artifactName": "Haven-Setup-${version}.${ext}",
			"installerIcon": "public/icon.ico",
			"uninstallerIcon": "public/icon.ico",
			"installerHeaderIcon": "public/icon.ico",
			"differentialPackage": true
		},
		"linux": {
			"icon": "public/logo.png",
			"target": [
				"AppImage",
				"deb"
			]
		},
		"afterPack": "./scripts/apply-electron-fuses.cjs",
		"asar": true
	},
	"dependencies": {
		"@chenglou/pretext": "0.0.6",
		"@kobalte/core": "0.13.11",
		"bytenode": "1.5.7",
		"@tanstack/solid-query": "5.100.5",
		"@tanstack/solid-virtual": "3.13.24",
		"class-variance-authority": "0.7.1",
		"clsx": "2.1.1",
		"electron-log": "5.4.3",
		"electron-updater": "6.8.3",
		"email-validator": "2.0.4",
		"libsodium-wrappers-sumo": "0.8.4",
		"lucide-solid": "1.11.0",
		"secure-remote-password": "0.3.1",
		"solid-js": "1.9.12",
		"solid-motionone": "1.0.4",
		"tailwind-merge": "3.5.0",
		"tailwindcss-animate": "1.0.7"
	},
	"lint-staged": {
		"*": [
			"biome check --write --no-errors-on-unmatched"
		]
	}
}
